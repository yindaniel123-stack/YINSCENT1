{
  "functions": {
    "api/**/*.js": {
      "includeFiles": ["api/_routes/**", "js/products.js", "js/i18n.js"]
    }
  },
  "rewrites": [
    { "source": "/api/:section/:rest*", "destination": "/api/gate?route=:section/:rest*" },
    { "source": "/product.html", "destination": "/index.html" },
    { "source": "/story.html", "destination": "/index.html" },
    { "source": "/story", "destination": "/index.html" },
    { "source": "/checkout.html", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" }
  ]
}