ADMIN_PASSWORD=your-password-here

# SMS alerts for the contact form (Twilio). Use E.164 numbers, e.g. +8613800138000.
# Keys stay on the server. Never put them in frontend code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CONTACT_SMS_TO=

# Login codes. +86 uses the domestic channel. Every other country uses the
# international channel. Provider is "twilio" or "http".
# Domestic Twilio sender falls back to TWILIO_FROM_NUMBER.
# International Twilio needs its own sender in SMS_INTL_FROM.
SMS_CN_PROVIDER=twilio
SMS_CN_FROM=
SMS_INTL_PROVIDER=twilio
SMS_INTL_FROM=
# Optional HTTP gateways. The server POSTs {to,text,lane} with Authorization: Bearer key.
SMS_CN_HTTP_URL=
SMS_CN_HTTP_KEY=
SMS_INTL_HTTP_URL=
SMS_INTL_HTTP_KEY=
# Cost is counted in cents. Sends stop when this month's total would pass the cap.
SMS_CN_COST_CENTS=5
SMS_INTL_COST_CENTS=8
SMS_COST_CAP_CENTS=5000
# Attempts on the first channel, then one try on the other channel.
SMS_MAX_ATTEMPTS=2
SMS_FAILOVER=1

# Member sign-in. AUTH_SECRET signs member sessions. If it is empty, the
# server derives a secret from ADMIN_PASSWORD.
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Registration applications and member activity are mailed here.
NOTIFY_EMAIL=yindaniel123@gmail.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
